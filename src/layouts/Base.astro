---
import "../styles/global.css";
import { RELEASE } from "../release.mjs";

interface Props { title?: string; description?: string }
const { title, description = "Tu librería de Rekordbox o la de Traktor en una sola app. Marcás playlists y salen al USB, una carpeta por playlist, con las pistas numeradas en el orden en que las armaste." } = Astro.props;
const fullTitle = title ? `${title} · List Buddy` : "List Buddy · Todas tus playlists. Un solo lugar.";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}/`;

---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Solo en github.io (hostname distinto cuando lo sirve el portfolio: sin loop). -->
    <script is:inline data-gh-redirect>
      if (location.hostname.endsWith("github.io")) {
        location.replace("https://www.gabrielmaglia.me/apps/listbuddy/" + location.pathname.replace(/^\/listbuddy-site\/?/, "") + location.search + location.hash);
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1C1C1C" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="pad">
      <div class="wrap hdr">
        <nav aria-label="Secciones">
          <a href={`${home}#spec`}>Función</a>
          <a href={`${home}#modulos`}>Módulos</a>
          <a href={`${home}#descargas`}>Descargas</a>
          <a href={`${home}#faq`}>FAQ</a>
        </nav>
        <a class="brand" href={home}>List Buddy</a>
        <div class="hdr-r">
          <span class="ver">LB·{RELEASE}</span>
          <a class="btn btn-s" href={`${home}#descargas`}>Descargar</a>
        </div>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer>
      <div class="wrap">
        <span>© 2025‑2026 Gabriel Maglia · Rosario, AR</span>
        <nav aria-label="Legal">
          <a href={`${base}/legal/`}>Términos y privacidad</a>
          <a href={`${base}/terceros/`}>Terceros</a>
          <a href="https://github.com/gabiMaglia/listbuddy">GitHub</a>
          <a href="https://ko-fi.com/gabrielmaglia">Ko‑fi</a>
        </nav>
        <p class="tm">Rekordbox: marca de AlphaTheta Corporation. Traktor, Native Instruments: marcas de Native Instruments GmbH. Sin afiliación.</p>
        <p class="tm">Tipografías bajo SIL Open Font License (<a href={`${base}/fonts/LICENSES.txt`}>licencias</a>).</p>
      </div>
    </footer>
  </body>
</html>

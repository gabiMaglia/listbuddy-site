---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import { RELEASE, REPO, ASSETS, assetUrl } from "../release.mjs";

const win = ASSETS.find((a) => a.file.endsWith("win64.zip"))!;
const arm = ASSETS[0]!;

const steps = [
  { n: "01", t: "Exportar colección", d: "Rekordbox: Archivo → Exportar colección en xml. Traktor: ruta a collection.nml. No hace falta cerrar el programa." },
  { n: "02", t: "Seleccionar · previa", d: "Árbol de carpetas y playlists. Vista previa de la salida, reproducción, detección de enlaces rotos." },
  { n: "03", t: "Copiar", d: "Destino: USB, SD o disco. Carpetas numeradas, progreso, registro de copiadas y faltantes." },
];

const modules = [
  { id: "LB-01 EXPORT", t: "Copia con prefijo numérico", d: "Bit a bit, sin re-encode. Nombre limpio de caracteres inválidos. Progreso y registro por lote. Verificación de integridad al final." },
  { id: "LB-02 PREVIEW", t: "Vista previa y reproducción", d: "Lo que va a salir, playlist por playlist, antes de copiar. Reproductor con forma de onda y búsqueda. 800 playlists sin trabar la interfaz." },
  { id: "LB-03 RELOCATE", t: "Reparación de enlaces", d: "Archivos movidos de disco: búsqueda por nombre, propuesta de ruta nueva. Rekordbox: las reparaciones se guardan aparte y se puede generar un XML importable. Traktor: escribe el NML con copia de seguridad previa." },
  { id: "LB-04 INTEGRITY", t: "Integridad del software", d: "macOS: firmado con Developer ID y notarizado por Apple. Windows: sin firma, hash SHA‑256 publicado. Dependencias fijadas con hashes. Código fuente de cada versión junto a la descarga." },
  { id: "LB-05 PRIVACY", t: "Sin red", d: "No hay cuenta, servidor ni telemetría. La única conexión es el chequeo de versión nueva al iniciar, desactivable en Configuración → Privacidad." },
];

const faq = [
  { q: "¿Hay que cerrar Rekordbox?", a: "No. Se lee el XML exportado. Para escribir el NML de Traktor (reparación de enlaces) sí conviene cerrarlo." },
  { q: "¿Modifica la base de datos?", a: "Nunca abre ni escribe master.db. Las reparaciones de Rekordbox van a un archivo propio; se puede generar un XML nuevo para importar." },
  { q: "¿Convierte o normaliza el audio?", a: "No. Copia el archivo original byte a byte; solo cambia el nombre del archivo de destino." },
  { q: "¿Qué cambia en la 1.1?", a: "Listas propias y exportación cruzada, con licencia de pago. La 1.0 queda disponible bajo GPL‑3.0, sin soporte." },
];
---
<Base>
  <section id="top" class="pad">
    <div class="wrap g12 hero">
      <div class="hero-t">
        <p class="eyebrow">LB-1.0 · Utilidad de exportación · macOS / Windows</p>
        <h1>Todas tus playlists.<br />Un solo lugar.</h1>
        <p class="led">Rekordbox · Traktor · USB</p>
        <p class="lede">Tu librería de Rekordbox y la de Traktor en una sola vista. Marcás playlists, escuchás, y salen al USB como carpetas numeradas, en el orden en que las armaste. No convierte, no toca la base de datos, no usa red.</p>
        <dl class="spec">
          <dt>Entrada</dt><dd>Rekordbox 6 / 7 · XML exportado — Traktor Pro 3 / 4 · collection.nml</dd>
          <dt>Salida</dt><dd>una carpeta por playlist · <b>001 - Artista - Título.ext</b> · copia bit a bit</dd>
          <dt>Audio</dt><dd>previa con forma de onda · mp3 aiff wav flac m4a</dd>
          <dt>Red</dt><dd>ninguna (aviso de versión opcional)</dd>
          <dt>Licencia</dt><dd>1.0 GPL‑3.0, gratis · 1.1 en adelante con licencia de pago</dd>
        </dl>
        <div class="cta">
          <a class="btn btn-l" href={`https://github.com/${REPO}/releases/latest`}>Descargar · Mac</a>
          <a class="btn2" href={assetUrl(win.file)}>Descargar · Windows</a>
        </div>
      </div>
      <Figure variant="hero" file="fig-01.jpg" width={1200} height={1600} kind="Fig. 01 · Foto" desc="Macro de un pendrive entrando en el puerto USB de una reproductora, luz dura, fondo negro. Blanco y negro o color apagado. Sin logos legibles." />
    </div>
  </section>

  <Section id="spec" num="01" title="Función">
    <div class="steps">
      {steps.map((s) => (
        <div class="step"><span class="pix">{s.n}</span><strong>{s.t}</strong><span>{s.d}</span></div>
      ))}
    </div>
  </Section>

  <Section num="02" title="Salida" alt note="Lo que queda en el volumen después de exportar tres playlists. Nombres de ejemplo.">
    <div class="tree">
      <div class="tree-g">
        <span class="m">/Volumes/USB_DJ</span><span></span><span class="m">tamaño</span>
        <span class="t">01_Warm_Up/</span><span></span><span>42 · 612 MB</span>
        <span></span><span>001 - Jayda G - Both Of Us.mp3</span><span>14,1 MB</span>
        <span></span><span>002 - Kerri Chandler - Rain.aiff</span><span>81,6 MB</span>
        <span></span><span>003 - Moodymann - Shades Of Jae.flac</span><span>42,0 MB</span>
        <span></span><span class="m">… 039 más</span><span></span>
        <span class="t">02_Peak/</span><span></span><span>58 · 1,1 GB</span>
        <span></span><span>001 - Floating Points - Vocoder.aiff</span><span>64,2 MB</span>
        <span></span><span class="m">… 057 más</span><span></span>
        <span class="t">03_Closing/</span><span></span><span>31 · 498 MB</span>
        <span></span><span>001 - Larry Heard - Missing You.mp3</span><span>15,3 MB</span>
        <span></span><span class="m">… 030 más</span><span></span>
        <span class="ok">OK</span><span class="mt">131 copiadas · 0 faltantes · hashes verificados</span><span class="mt">2,2 GB</span>
      </div>
    </div>
  </Section>

  <Section id="modulos" num="03" title="Módulos">
    <div class="mods">
      {modules.map((m) => (
        <div class="mod"><span class="id">{m.id}</span><div><strong>{m.t}</strong><span class="d">{m.d}</span></div></div>
      ))}
    </div>
  </Section>

  <Section num="04" title="Interfaz" alt note="Captura real de la 1.0 en macOS, tema oscuro. Una sola, sin marco de dispositivo.">
    <Figure variant="ui" file="fig-02.png" width={1600} height={1000} kind="Fig. 02 · Captura" desc="List Buddy 1.0 en macOS, tema oscuro: árbol de playlists a la izquierda, vista previa de la salida con enlaces rotos marcados, y el reproductor con forma de onda, destino y botón Exportar abajo." />
  </Section>

  <Section id="descargas" num="05" title="Descargas" note={`Versión ${RELEASE} · 2026‑10. Cada archivo con su .sha256.`}>
    <div class="dls">
      {ASSETS.map((a) => (
        <a class="dl" href={assetUrl(a.file)}>
          <strong>{a.label}</strong>
          <span class="go">{a.kind} ↓</span>
          <span class="metas"><span class="meta">{a.file}</span><span class="meta">{a.size}</span><span class="meta">{a.req}</span></span>
        </a>
      ))}
      <div class="dl-note">
        <span>Verificación</span> · shasum -a 256 -c {arm.file}.sha256 → OK<br />
        macOS: Developer ID + notarización Apple, abre con doble click. Windows: sin firma de código, SmartScreen puede avisar; comparar el hash.<br />
        <a href={`https://github.com/${REPO}/releases`}>Todas las versiones</a>
      </div>
    </div>
  </Section>

  <Section id="faq" num="06" title="FAQ" alt>
    {faq.map((f) => (
      <details><summary>{f.q} <i aria-hidden="true"></i></summary><p>{f.a}</p></details>
    ))}
  </Section>
</Base>

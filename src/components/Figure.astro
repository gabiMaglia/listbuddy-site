---
import fs from "node:fs";
import path from "node:path";

// Si existe public/img/<file> se usa la imagen real; si no, un panel neutro que sostiene la grilla.
// La descripción va solo en alt (lectores de pantalla); no hay epígrafe visible. El hero conserva la banda negra al pie de la foto (pedido del PO).
interface Props { file: string; width: number; height: number; desc: string; variant: "hero" | "ui" }
const { file, width, height, desc, variant } = Astro.props;
// Desde la raíz del proyecto: en el build, import.meta.url apunta al chunk compilado y la ruta relativa no existe.
const exists = fs.existsSync(path.join(process.cwd(), "public", "img", file));
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/img/${file}`;
---
{exists ? (
  <figure class={variant === "hero" ? "fig-hero" : "fig-ui"}>
    {variant === "ui" ? (
      <div class="frame"><img src={src} alt={desc} width={width} height={height} loading="lazy" decoding="async" /></div>
    ) : (
      <img src={src} alt={desc} width={width} height={height} decoding="async" fetchpriority="high" />
    )}
    {variant === "hero" && <div class="fig-band" aria-hidden="true"></div>}
  </figure>
) : (
  <div class={variant === "hero" ? "fig-hero" : "fig-ui"} aria-hidden="true">
    {variant === "ui" ? <div class="frame"><div class="ph"></div></div> : <div class="ph"></div>}
  </div>
)}

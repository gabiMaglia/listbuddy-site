---
import fs from "node:fs";
import path from "node:path";

// Si existe public/img/<file> se usa la imagen real con epígrafe; si no, un panel neutro que sostiene la grilla, sin texto.
// alt vacío a propósito: el figcaption ya describe la figura. Sin archivo no hay epígrafe.
interface Props { file: string; width: number; height: number; kind: string; desc: string; variant: "hero" | "ui" }
const { file, width, height, kind, desc, variant } = Astro.props;
// Desde la raíz del proyecto: en el build, import.meta.url apunta al chunk compilado y la ruta relativa no existe.
const exists = fs.existsSync(path.join(process.cwd(), "public", "img", file));
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/img/${file}`;
---
{exists ? (
  <figure class={variant === "hero" ? "fig-hero" : "fig-ui"}>
    {variant === "ui" ? (
      <div class="frame"><img src={src} alt="" width={width} height={height} loading="lazy" decoding="async" /></div>
    ) : (
      <img src={src} alt="" width={width} height={height} decoding="async" fetchpriority="high" />
    )}
    <figcaption>
      <span class="fig-k">{kind}</span>
      <span class="fig-d">{desc}</span>
    </figcaption>
  </figure>
) : (
  <div class={variant === "hero" ? "fig-hero" : "fig-ui"} aria-hidden="true">
    {variant === "ui" ? <div class="frame"><div class="ph"></div></div> : <div class="ph"></div>}
  </div>
)}
